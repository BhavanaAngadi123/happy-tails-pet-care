SECRET_KEY=replace-with-a-long-random-secret
# Supabase/PostgreSQL example. Use the exact connection string supplied by your provider.
# If the provider gives postgres://, config.py normalizes it for SQLAlchemy/psycopg.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@example.com
