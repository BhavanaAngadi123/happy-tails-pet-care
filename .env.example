# Happy Tails Spring Boot environment template
# Never commit real passwords, SMTP credentials, or API keys.

# PostgreSQL production database
DB_HOST=
DB_PORT=5432
DB_NAME=happytails
DB_USER=
DB_PASSWORD=

# SMTP delivery for password reset
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# Keep disabled until SMTP has been configured and tested.
PASSWORD_RESET_ENABLED=false

# Optional outside Render. Render automatically provides RENDER_EXTERNAL_URL,
# which Happy Tails uses for reset links when APP_BASE_URL is absent.
APP_BASE_URL=

# Spring / server
SPRING_PROFILES_ACTIVE=prod
PORT=10000
